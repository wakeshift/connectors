{
  "name": "@wakeshift/openclaw",
  "version": "0.0.0",
  "description": "Wakeshift for OpenClaw: wakes an OpenClaw session when an app it watches through Wakeshift sends something.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wakeshift/connectors.git",
    "directory": "plugins/openclaw"
  },
  "homepage": "https://wakeshift.ai/docs/agents",
  "bugs": {
    "url": "https://github.com/wakeshift/connectors/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "wakeshift",
    "ai-agents",
    "mcp-events",
    "notifications"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.4",
      "minGatewayVersion": "2026.10.4"
    },
    "build": {
      "openclawVersion": "2026.10.4"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test 'build-test/test/*.test.js'",
    "pack": "npm run build && node scripts/stamp-version.mjs && npm pack --pack-destination ${PACK_DIR:-.} && mv ${PACK_DIR:-.}/wakeshift-openclaw-$npm_package_version.tgz ${PACK_DIR:-.}/wakeshift-openclaw.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
